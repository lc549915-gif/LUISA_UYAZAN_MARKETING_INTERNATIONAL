  fAbout:"A little taste of Colombia, wherever life takes you.",fContact:"Contact",fHours:"Mon–Fri, 9am–5pm ET",fExplore:"Explore",promoLink:"Offers",fPolicies:"Purchase policies",
  p1:"Shipping",p1d:"Orders ship within 1–3 business days. Tracking is sent by email.",p2:"Returns",p2d:"Unopened packs can be returned within 14 days. Damaged items are replaced.",p3:"Privacy",p3d:"We only use your data to process orders and never sell it.",rights:"All rights reserved.",
  cart:"Cart",ship:"Shipping",calc:"Calculated at checkout",total:"Total",clear:"Empty cart",checkout:"Checkout",emptyMsg:"Your cart is empty. Add some cookies!",added:"Added to cart",
  confirmEmpty:"Are you sure you want to empty the cart?",alreadyEmpty:"🛒 Your cart is already empty.",needItems:"🛒 Your cart is empty. Add products before checking out.",
  done:"🎉 Simulated order confirmed!\n\nIn a real store, the backend, payment gateway and logistics would take over now."},
 es:{skip:"Saltar al contenido",nav1:"Inicio",nav2:"Productos",nav3:"Nuestra historia",nav4:"Contacto",shop:"Comprar ahora",
  slogan:"Un pedacito de Colombia, donde sea que la vida te lleve",
  heroText:"Lejos de casa, un bocado puede traerte de vuelta la cocina de la abuela, las visitas del domingo y las risas de la familia. Quimbayas lleva ese recuerdo a tu mesa en EE. UU.",
  heroBtn2:"Nuestra historia",stamp:"Hecho en Colombia",b1:"🚚 Envíos a todo EE. UU.",b2:"🔒 Compra segura",b3:"📦 Seguimiento de pedido",b4:"🇨🇴 Sabor auténtico colombiano",
  prodTitle:"Nuestras galletas",prodSub:"Cinco formas de llevar un pedazo de Colombia a casa. Elige tu favorita o pruébalas todas.",
  add:"Agregar al carrito",best:"Más vendida",
  n1:"Quimbayas Original",d1:"El sabor clásico colombiano que recuerdas, en cada bocado.",
  n2:"Quimbayas Mini",d2:"Pequeñas en tamaño, grandes en sabor. Perfectas a cualquier hora.",
  n3:"Quimbayas Family Pack",d3:"Hechas para compartir en la mesa, la fiesta y la visita del fin de semana.",
  n4:"Quimbayas Premium",d4:"Una presentación especial: tradición, calidad y un sabor irresistible.",
  n5:"Quimbayas Snack Pack",d5:"Llévate un pedacito de Colombia al trabajo, al colegio o a la carretera. 🇨🇴",
  storyTitle:"Un sabor que recuerda el hogar",story1:"Las Quimbayas son las galletas con las que muchos crecimos: las de la lonchera, las de la mesa del café, las que un familiar metía en tu maleta.",
  story2:"Cuando vives lejos de Colombia, esos sabores son más que un snack. Son una forma de compartir nuestras raíces con los hijos, los amigos y los vecinos que preguntan: «¿Qué estás comiendo?».",
  whyTitle:"Por qué las familias eligen Quimbayas",w1t:"Nostalgia de verdad",w1d:"El mismo sabor que reconoces y recuerdas, hecho en Colombia.",w2t:"A la puerta de tu casa",w2d:"Envíos a todo Estados Unidos, con seguimiento en cada pedido.",w3t:"Hechas para compartir",w3d:"Paquetes familiares y tamaños snack para cada mesa, viaje y reunión.",
  craftTitle:"Tradición colombiana, con mucho cuidado",craftSub:"Cada paquete lleva el cariño de una receta que pasa de generación en generación.",
  c1t:"Espíritu natural",c1d:"Inspiradas en la tierra y los sabores de Colombia.",c2t:"Calidad que se siente",c2d:"Producción cuidadosa y empaque sellado para que lleguen frescas.",c3t:"Perfectas con café",c3d:"Un clásico colombiano para el tinto de la tarde, el café con leche o el chocolate caliente.",
  testTitle:"Lo que dice nuestra comunidad",q1:"«Abrí la caja y mi cocina olía a mi infancia en Medellín.»",q2:"«Mis hijos por fin entienden qué quiero decir con 'sabor a casa'.»",q3:"«El paquete familiar voló en un fin de semana con los primos. Vuelvo a pedir.»",
  promoTitle:"Bienvenida: 10 % de descuento en tu primer pedido",promoText:"Usa este código al pagar y únete a nuestra lista para conocer nuevos sabores, cajas de temporada y tradiciones colombianas.",emailLabel:"Correo electrónico",join:"Unirme",joined:"¡Gracias! Pronto revisa tu correo.",
  faqTitle:"Preguntas frecuentes",
  f1q:"¿A dónde envían?",f1a:"Enviamos a direcciones en todo Estados Unidos. Los tiempos de entrega aparecen al pagar.",
  f2q:"¿Las Quimbayas son realmente de Colombia?",f2a:"Sí. Cada paquete es un producto colombiano, seleccionado para conservar el sabor que recuerdas.",
  f3q:"¿Cuánto duran frescas las galletas?",f3a:"Revisa la fecha de consumo preferente impresa en cada paquete. Una vez abiertas, guárdalas en un recipiente sellado.",
  f4q:"¿Puedo enviarlas de regalo?",f4a:"Claro. Agrega la dirección de quien las recibe al pagar y cuéntanos en las notas del pedido.",
  f5q:"¿Y si mi pedido llega dañado?",f5a:"Escríbenos dentro de 7 días con una foto y lo resolvemos.",
  fAbout:"Un pedacito de Colombia, donde sea que la vida te lleve.",fContact:"Contacto",fHours:"Lun–Vie, 9 a. m.–5 p. m. ET",fExplore:"Explorar",promoLink:"Promociones",fPolicies:"Políticas de compra",
  p1:"Envíos",p1d:"Los pedidos salen en 1–3 días hábiles. Te enviamos el seguimiento por correo.",p2:"Devoluciones",p2d:"Los paquetes sin abrir se pueden devolver en 14 días. Los productos dañados se reponen.",p3:"Privacidad",p3d:"Usamos tus datos solo para procesar pedidos y nunca los vendemos.",rights:"Todos los derechos reservados.",
  cart:"Carrito",ship:"Envío",calc:"Se calcula al pagar",total:"Total",clear:"Vaciar carrito",checkout:"Finalizar compra",emptyMsg:"Tu carrito está vacío. ¡Agrega unas galletas!",added:"Agregado al carrito",
  confirmEmpty:"¿Estás seguro de que quieres vaciar el carrito?",alreadyEmpty:"🛒 El carrito ya está vacío.",needItems:"🛒 Tu carrito está vacío. Agrega productos antes de finalizar la compra.",
  done:"🎉 ¡Pedido simulado confirmado!\n\nEn un eCommerce real, ahora entrarían en acción el backend, la pasarela de pago y la logística."}
};

let lang = "en";
try { lang = localStorage.getItem("lang") || "en"; } catch(e) {}
if (!T[lang]) lang = "en";
const t = k => T[lang][k] || k;
const usd = n => n.toLocaleString("en-US", {style:"currency", currency:"USD"});
const carrito = [];

const $ = id => document.getElementById(id);
const contenedorProductos = $("productosGrid");
const listaCarrito = $("lista-carrito");
const totalCarrito = $("total");

/* ===== LANGUAGE ===== */
function aplicarIdioma() {
  document.documentElement.lang = lang;
  document.querySelectorAll("[data-i18n]").forEach(el => { el.textContent = t(el.dataset.i18n); });
  document.querySelectorAll(".lang button").forEach(b => b.setAttribute("aria-pressed", b.dataset.lang === lang));
  $("abrirCarrito").setAttribute("aria-label", lang === "en" ? "Open cart" : "Abrir carrito");
  mostrarProductos();
  actualizarCarrito();
}
document.querySelectorAll(".lang button").forEach(b => b.addEventListener("click", () => {
  lang = b.dataset.lang;
  try { localStorage.setItem("lang", lang); } catch(e) {}
  aplicarIdioma();
}));

/* ===== PRODUCTS ===== */
function mostrarProductos() {
  contenedorProductos.innerHTML = "";
  productos.forEach(prod => {
    const nombre = t("n" + prod.id);
    const div = document.createElement("article");
    div.className = "card";
    div.innerHTML = `
      <div class="ph">
        ${prod.id === 1 ? `<span class="badge">${t("best")}</span>` : ""}
        <img src="${prod.imagen}" alt="${nombre}" width="400" height="400" loading="lazy">
      </div>
      <div class="b">
        <h3>${nombre}</h3>
        <p>${t("d" + prod.id)}</p>
        <div class="row">
          <span class="price">${usd(prod.precio)}</span>
          <button class="btn sm" onclick="agregarAlCarrito(${prod.id})">${t("add")}</button>
        </div>
      </div>`;
    contenedorProductos.appendChild(div);
  });
}

/* ===== CART ===== */
function agregarAlCarrito(id) {
  const existente = carrito.find(p => p.id === id);
  if (existente) existente.cantidad++;
  else carrito.push({...productos.find(p => p.id === id), cantidad: 1});
  actualizarCarrito();
  avisar(t("added"));
}

function cambiarCantidad(id, d) {
  const item = carrito.find(p => p.id === id);
  if (!item) return;
  item.cantidad += d;
  if (item.cantidad <= 0) carrito.splice(carrito.indexOf(item), 1);
  actualizarCarrito();
}

function actualizarCarrito() {
  listaCarrito.innerHTML = "";
  let total = 0, totalItems = 0;
  carrito.forEach(item => {
    const li = document.createElement("li");
    const subtotal = item.precio * item.cantidad;
    li.innerHTML = `
      <img src="${item.imagen}" alt="">
      <div class="t"><strong>${t("n" + item.id)}</strong><br>${usd(subtotal)}</div>
      <div class="qty">
        <button aria-label="−" onclick="cambiarCantidad(${item.id},-1)">−</button>
        <span>${item.cantidad}</span>
        <button aria-label="+" onclick="cambiarCantidad(${item.id},1)">+</button>
      </div>`;
    listaCarrito.appendChild(li);
    total += subtotal;
    totalItems += item.cantidad;
  });
  if (!carrito.length) {
    const li = document.createElement("li");
    li.className = "empty";
    li.textContent = t("emptyMsg");
    listaCarrito.appendChild(li);
  }
  totalCarrito.textContent = usd(total);
  $("contador").textContent = totalItems;
  actualizarTituloCarrito(totalItems);
}

function actualizarTituloCarrito(cantidad) {
  $("tituloCarrito").textContent = `🧾 ${t("cart")} (${cantidad})`;
}

function vaciarCarrito() {
  if (carrito.length === 0) { alert(t("alreadyEmpty")); return; }
  if (confirm(t("confirmEmpty"))) { carrito.length = 0; actualizarCarrito(); }
}

function finalizarCompra() {
  if (carrito.length === 0) { alert(t("needItems")); return; }
  alert(t("done"));
  carrito.length = 0;
  actualizarCarrito();
  abrirCarrito(false);
}

/* ===== DRAWER, MENU, TOAST ===== */
function abrirCarrito(abrir) {
  $("drawer").classList.toggle("on", abrir);
  $("ov").classList.toggle("on", abrir);
  $("drawer").setAttribute("aria-hidden", !abrir);
  if (abrir) $("cerrarCarrito").focus(); else $("abrirCarrito").focus();
}
$("abrirCarrito").addEventListener("click", () => abrirCarrito(true));
$("cerrarCarrito").addEventListener("click", () => abrirCarrito(false));
$("ov").addEventListener("click", () => abrirCarrito(false));
document.addEventListener("keydown", e => { if (e.key === "Escape") { abrirCarrito(false); cerrarMenu(); } });

const burger = $("burger"), menu = $("menu");
function cerrarMenu() { menu.classList.remove("open"); burger.setAttribute("aria-expanded", "false"); }
burger.addEventListener("click", () => {
  const open = menu.classList.toggle("open");
  burger.setAttribute("aria-expanded", open);
});
menu.querySelectorAll("a").forEach(a => a.addEventListener("click", cerrarMenu));

let toastTimer;
function avisar(msg) {
  const el = $("toast");
  el.textContent = msg;
  el.classList.add("on");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove("on"), 1800);
}

$("newsForm").addEventListener("submit", e => {
  e.preventDefault();
  $("newsMsg").textContent = t("joined");
  e.target.reset();
});

$("year").textContent = new Date().getFullYear();

/* ===== START ===== */
aplicarIdioma();
</script>
</body>
</html>
