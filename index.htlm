<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Quimbayas: A Sweet Taste of Colombia | Colombian Cookies Shipped in the U.S.</title>
<meta name="description" content="Quimbayas, the Colombian cookies you grew up with, delivered across the United States. A little taste of Colombia, wherever life takes you.">
<meta property="og:title" content="Quimbayas: A Sweet Taste of Colombia">
<meta property="og:description" content="A little taste of Colombia, wherever life takes you.">
<meta property="og:type" content="website">
<meta name="theme-color" content="#B83245">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Store","name":"Quimbayas","description":"Colombian cookies for Latino families in the United States","areaServed":"US"}</script>
<style>
:root{--guava:#B83245;--cream:#F5DFA8;--green:#526B45;--ivory:#FFF9EF;--cacao:#493329;--guava-d:#9a2437;--line:rgba(73,51,41,.15);--r:14px;--serif:'Fraunces',Georgia,serif;--sans:'Figtree',system-ui,Arial,sans-serif}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:76px}
body{font-family:var(--sans);background:var(--ivory);color:var(--cacao);line-height:1.6;font-size:17px}
img{max-width:100%;display:block}
a{color:inherit}
h1,h2,h3{font-family:var(--serif);line-height:1.15;font-weight:700}
h2{font-size:clamp(1.8rem,4vw,2.7rem);margin-bottom:.6rem}
p{max-width:62ch}
:focus-visible{outline:3px solid var(--green);outline-offset:3px}
.wrap{width:min(1160px,92%);margin-inline:auto}
section{padding:clamp(3.5rem,8vw,6rem) 0}
.head{margin-bottom:2.2rem}.head p{color:rgba(73,51,41,.8)}
.btn{display:inline-block;border:2px solid var(--guava);background:var(--guava);color:var(--ivory);padding:.75rem 1.5rem;border-radius:999px;font:600 1rem var(--sans);text-decoration:none;cursor:pointer;transition:background .2s,transform .2s,color .2s}
.btn:hover{background:var(--guava-d);transform:translateY(-2px)}
.btn.ghost{background:transparent;color:var(--guava)}
.btn.ghost:hover{background:var(--guava);color:var(--ivory)}
.btn.sm{padding:.5rem 1.1rem;font-size:.95rem}
/* header */
header{position:sticky;top:0;z-index:50;background:rgba(255,249,239,.96);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;gap:1rem;height:68px}
.logo{display:flex;align-items:center;gap:.5rem;text-decoration:none;font:700 1.45rem var(--serif);color:var(--guava)}
.logo svg{width:34px;height:34px}
nav{margin-left:auto;display:flex;align-items:center;gap:1.6rem}
nav a{text-decoration:none;font-weight:500;position:relative}
nav a:not(.btn)::after{content:"";position:absolute;left:0;bottom:-4px;height:2px;width:0;background:var(--guava);transition:width .25s}
nav a:not(.btn):hover::after{width:100%}
.tools{display:flex;align-items:center;gap:.6rem}
.lang{display:flex;border:1.5px solid var(--cacao);border-radius:999px;overflow:hidden}
.lang button{border:0;background:none;padding:.3rem .7rem;font:600 .85rem var(--sans);color:var(--cacao);cursor:pointer}
.lang button[aria-pressed=true]{background:var(--cacao);color:var(--ivory)}
.cartbtn{position:relative;border:0;background:none;cursor:pointer;color:var(--cacao);padding:.4rem}
.cartbtn svg{width:26px;height:26px}
.cartbtn .n{position:absolute;top:-2px;right:-4px;background:var(--guava);color:#fff;font:600 .72rem var(--sans);min-width:19px;height:19px;border-radius:99px;display:grid;place-items:center}
.burger{display:none;border:0;background:none;cursor:pointer;padding:.4rem}
.burger span{display:block;width:24px;height:2px;background:var(--cacao);margin:5px 0;transition:.25s}
.burger[aria-expanded=true] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.burger[aria-expanded=true] span:nth-child(2){opacity:0}
.burger[aria-expanded=true] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
@media(max-width:860px){
 .burger{display:block}
 nav{position:absolute;top:68px;left:0;right:0;flex-direction:column;align-items:stretch;gap:0;background:var(--ivory);border-bottom:1px solid var(--line);padding:.5rem 4%;margin:0;display:none}
 nav.open{display:flex}
 nav a{padding:.9rem 0;border-bottom:1px solid var(--line)}
 nav a.btn{margin:.8rem 0;text-align:center}
 .tools{margin-left:auto}
}
/* hero */
.hero{padding:clamp(2.5rem,6vw,4.5rem) 0 clamp(3rem,7vw,5.5rem);background:linear-gradient(180deg,var(--ivory),#fbefd0)}
.hero .wrap{display:grid;gap:2.5rem;align-items:center}
@media(min-width:900px){.hero .wrap{grid-template-columns:1.1fr .9fr}}
.hero h1{font-size:clamp(2.4rem,6vw,4.4rem);color:var(--guava);margin-bottom:.4rem}
.tag{font:500 italic clamp(1.15rem,2.4vw,1.5rem) var(--serif);color:var(--green);margin-bottom:1.2rem}
.hero p.lead{margin-bottom:1.8rem;font-size:1.1rem}
.cta{display:flex;flex-wrap:wrap;gap:.8rem}
.arch{position:relative;width:min(420px,86%);margin-inline:auto;aspect-ratio:4/5;background:var(--guava);border-radius:999px 999px 24px 24px;padding:14px;animation:rise 1s ease both}
.arch img{width:100%;height:100%;object-fit:cover;border-radius:999px 999px 14px 14px;background:var(--cream)}
.arch .stamp{position:absolute;right:-14px;bottom:28px;background:var(--cream);color:var(--cacao);padding:.55rem 1rem;border-radius:999px;font:700 .95rem var(--serif);box-shadow:0 6px 18px rgba(73,51,41,.2);transform:rotate(-4deg)}
@keyframes rise{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
/* benefits strip */
.strip{background:var(--green);color:var(--ivory);padding:1.1rem 0}
.strip ul{list-style:none;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem 2.2rem;font-weight:500}
/* products */
.grid{display:grid;gap:1.4rem;grid-template-columns:repeat(auto-fill,minmax(220px,1fr))}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column;transition:transform .25s,box-shadow .25s}
.card:hover{transform:translateY(-5px);box-shadow:0 14px 28px rgba(73,51,41,.14)}
.card img{width:100%;aspect-ratio:1;object-fit:cover;background:var(--cream)}
.card .b{padding:1rem 1.1rem 1.2rem;display:flex;flex-direction:column;gap:.4rem;flex:1}
.card h3{font-size:1.2rem}
.card p{font-size:.95rem;color:rgba(73,51,41,.8);flex:1}
.card .row{display:flex;align-items:center;justify-content:space-between;gap:.6rem;margin-top:.5rem}
.price{font:700 1.3rem var(--serif);color:var(--guava)}
.badge{position:absolute;top:10px;left:10px;background:var(--cream);font:600 .78rem var(--sans);padding:.2rem .7rem;border-radius:99px}
.card .ph{position:relative}
/* story */
.story{background:var(--cream)}
.two{display:grid;gap:2.5rem;align-items:center}
@media(min-width:860px){.two{grid-template-columns:1fr 1fr}}
.story img{border-radius:var(--r);aspect-ratio:4/3;object-fit:cover;width:100%;box-shadow:12px 12px 0 var(--guava)}
.story p+p{margin-top:1rem}
/* features */
.feat{display:grid;gap:1.6rem;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
.feat div{border-top:3px solid var(--guava);padding-top:1rem}
.feat h3{font-size:1.25rem;margin-bottom:.4rem}
.feat svg{width:34px;height:34px;color:var(--green);margin-bottom:.5rem}
.craft{background:var(--cacao);color:var(--ivory)}
.craft .head p{color:rgba(255,249,239,.85)}
.craft .feat div{border-color:var(--cream)}
.craft .feat svg{color:var(--cream)}
/* testimonials */
.quotes{display:grid;gap:1.4rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
blockquote{background:#fff;border:1px solid var(--line);border-left:5px solid var(--guava);border-radius:var(--r);padding:1.4rem}
blockquote p{font:500 1.1rem/1.5 var(--serif);margin-bottom:.8rem}
blockquote cite{font-style:normal;font-size:.9rem;color:var(--green);font-weight:600}
/* promo */
.promo{background:var(--guava);color:var(--ivory)}
.promo .wrap{display:grid;gap:2rem;align-items:center}
@media(min-width:860px){.promo .wrap{grid-template-columns:1.2fr 1fr}}
.code{display:inline-block;border:2px dashed var(--cream);padding:.3rem 1rem;border-radius:8px;font:700 1.2rem var(--serif);color:var(--cream);margin:.6rem 0}
.news{display:flex;gap:.5rem;flex-wrap:wrap}
.news input{flex:1;min-width:200px;padding:.8rem 1rem;border-radius:999px;border:2px solid var(--cream);font:1rem var(--sans);background:var(--ivory);color:var(--cacao)}
.promo .btn{background:var(--cream);border-color:var(--cream);color:var(--cacao)}
.promo .btn:hover{background:#fff}
.msg{min-height:1.5rem;margin-top:.5rem;font-weight:600}
/* faq */
details{border-bottom:1px solid var(--line);padding:1rem 0}
summary{cursor:pointer;font:600 1.1rem var(--serif);list-style:none;display:flex;justify-content:space-between;gap:1rem}
summary::after{content:"+";color:var(--guava);font-size:1.4rem;line-height:1}
details[open] summary::after{content:"–"}
details p{margin-top:.6rem;color:rgba(73,51,41,.85)}
.faqbox{max-width:780px}
/* footer */
footer{background:var(--cacao);color:var(--ivory);padding:3.5rem 0 1.5rem}
.fgrid{display:grid;gap:2rem;grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}
footer h3{font-size:1.1rem;color:var(--cream);margin-bottom:.7rem}
footer ul{list-style:none;padding:0}
footer li{margin-bottom:.4rem}
footer a{text-decoration:none;opacity:.9}footer a:hover{opacity:1;text-decoration:underline}
footer details{border-color:rgba(255,249,239,.2);padding:.6rem 0}
footer summary{font:500 1rem var(--sans)}
footer details p{color:rgba(255,249,239,.8);font-size:.92rem}
.soc{display:flex;gap:.7rem;margin-top:.8rem}
.soc a{width:40px;height:40px;border-radius:50%;border:1.5px solid var(--cream);display:grid;place-items:center;font:600 .8rem var(--sans);transition:background .2s,color .2s}
.soc a:hover{background:var(--cream);color:var(--cacao);text-decoration:none}
.copy{border-top:1px solid rgba(255,249,239,.2);margin-top:2.5rem;padding-top:1.2rem;font-size:.88rem;opacity:.85}
/* cart drawer */
.ov{position:fixed;inset:0;background:rgba(73,51,41,.5);opacity:0;pointer-events:none;transition:opacity .3s;z-index:90}
.ov.on{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:0;height:100%;width:min(400px,100%);background:var(--ivory);z-index:100;transform:translateX(100%);transition:transform .35s;display:flex;flex-direction:column;box-shadow:-10px 0 30px rgba(0,0,0,.2)}
.drawer.on{transform:none}
.drawer header{position:static;display:flex;justify-content:space-between;align-items:center;padding:1rem 1.2rem}
.drawer h2{font-size:1.4rem;margin:0}
.x{border:0;background:none;font-size:1.8rem;cursor:pointer;color:var(--cacao);line-height:1}
#lista-carrito{list-style:none;padding:0 1.2rem;overflow:auto;flex:1}
#lista-carrito li{display:flex;gap:.7rem;align-items:center;padding:.8rem 0;border-bottom:1px solid var(--line)}
#lista-carrito img{width:54px;height:54px;border-radius:8px;object-fit:cover}
#lista-carrito .t{flex:1;font-size:.95rem}
.qty{display:flex;align-items:center;gap:.4rem}
.qty button{width:28px;height:28px;border-radius:50%;border:1.5px solid var(--cacao);background:none;cursor:pointer;color:var(--cacao);font-size:1rem}
.empty{padding:1.2rem;color:rgba(73,51,41,.7)}
.resumen{border-top:1px solid var(--line);padding:1.2rem}
.total{font:700 1.3rem var(--serif);margin:.4rem 0 .9rem}
.acts{display:flex;gap:.6rem;flex-wrap:wrap}
.vaciar{background:transparent;color:var(--guava)}
.toast{position:fixed;left:50%;bottom:22px;transform:translate(-50%,120px);background:var(--green);color:#fff;padding:.7rem 1.3rem;border-radius:99px;z-index:120;transition:transform .3s;font-weight:600}
.toast.on{transform:translate(-50%,0)}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<a href="#main" class="btn sm" style="position:absolute;left:-999px" onfocus="this.style.left='8px'" onblur="this.style.left='-999px'" data-i18n="skip">Skip to content</a>

<header>
 <div class="wrap bar">
  <a class="logo" href="#inicio" aria-label="Quimbayas">
   <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="#B83245"/><circle cx="20" cy="20" r="12" fill="#F5DFA8"/><circle cx="16" cy="17" r="1.8" fill="#493329"/><circle cx="24" cy="16" r="1.8" fill="#493329"/><circle cx="21" cy="24" r="1.8" fill="#493329"/><path d="M20 2c3 3 7 3 10 2-2 3-6 5-10 4z" fill="#526B45"/></svg>
   Quimbayas
  </a>
  <nav id="menu" aria-label="Main">
   <a href="#inicio" data-i18n="nav1">Home</a>
   <a href="#productos" data-i18n="nav2">Products</a>
   <a href="#historia" data-i18n="nav3">Our story</a>
   <a href="#contacto" data-i18n="nav4">Contact</a>
   <a href="#productos" class="btn sm" data-i18n="shop">Shop now</a>
  </nav>
  <div class="tools">
   <div class="lang" role="group" aria-label="Language">
    <button data-lang="en" aria-pressed="true">EN</button><button data-lang="es" aria-pressed="false">ES</button>
   </div>
   <button class="cartbtn" id="abrirCarrito" aria-label="Open cart">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="20.5" r="1.3"/><circle cx="17" cy="20.5" r="1.3"/></svg>
    <span class="n" id="contador">0</span>
   </button>
   <button class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>
  </div>
 </div>
</header>

<main id="main">
<section class="hero" id="inicio">
 <div class="wrap">
  <div>
   <h1>Quimbayas: A Sweet Taste of Colombia</h1>
   <p class="tag" data-i18n="slogan">A Little Taste of Colombia, Wherever Life Takes You</p>
   <p class="lead" data-i18n="heroText">Far from home, one bite can bring back Grandma's kitchen, Sunday visits and the sound of family laughing. Quimbayas bring that memory to your table in the U.S.</p>
   <div class="cta">
    <a class="btn" href="#productos" data-i18n="shop">Shop now</a>
    <a class="btn ghost" href="#historia" data-i18n="heroBtn2">Our story</a>
   </div>
  </div>
  <div class="arch">
   <img src="https://lagolosineria.com.co/wp-content/uploads/2024/02/Quimbaya-x-18-und.jpg" alt="Quimbayas Colombian cookies" width="600" height="750" fetchpriority="high">
   <span class="stamp" data-i18n="stamp">Made in Colombia</span>
  </div>
 </div>
</section>

<div class="strip"><div class="wrap"><ul>
 <li data-i18n="b1">🚚 Shipping across the U.S.</li>
 <li data-i18n="b2">🔒 Secure checkout</li>
 <li data-i18n="b3">📦 Order tracking</li>
 <li data-i18n="b4">🇨🇴 Authentic Colombian flavor</li>
</ul></div></div>

<section id="productos">
 <div class="wrap">
  <div class="head"><h2 data-i18n="prodTitle">Our cookies</h2><p data-i18n="prodSub">Five ways to bring a piece of Colombia home. Pick your favorite, or try them all.</p></div>
  <div class="grid" id="productosGrid"></div>
 </div>
</section>

<section class="story" id="historia">
 <div class="wrap two">
  <img src="https://acdn-us.mitiendanube.com/stores/006/648/928/products/2-2d919a3a160c2339b117597904847875-1024-1024.webp" alt="Quimbayas family pack" width="640" height="480" loading="lazy">
  <div>
   <h2 data-i18n="storyTitle">A taste that remembers home</h2>
   <p data-i18n="story1">Quimbayas are the cookies many of us grew up with: the ones in the lunchbox, on the coffee table, in the bag a relative tucked into your suitcase.</p>
   <p data-i18n="story2">When you live far from Colombia, those flavors become more than a snack. They are a way to share our roots with our kids, our friends and the neighbors who ask, "What are you eating?"</p>
  </div>
 </div>
</section>

<section id="beneficios">
 <div class="wrap">
  <div class="head"><h2 data-i18n="whyTitle">Why families choose Quimbayas</h2></div>
  <div class="feat">
   <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.500-7 10-7 10z"/></svg><h3 data-i18n="w1t">Real nostalgia</h3><p data-i18n="w1d">The same recognizable flavor you remember, made in Colombia.</p></div>
   <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="7" width="14" height="10" rx="1"/><path d="M16 10h4l2 3v4h-6M6 20a1.500 1.500 0 1 0 0-.1M18 20a1.500 1.500 0 1 0 0-.1"/></svg><h3 data-i18n="w2t">Delivered to your door</h3><p data-i18n="w2d">Shipping across the United States, with tracking on every order.</p></div>
   <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.500"/><path d="M3 20c0-3.500 3-6 6-6s6 2.500 6 6M15 15c3 0 6 2 6 5"/></svg><h3 data-i18n="w3t">Made for sharing</h3><p data-i18n="w3d">Family packs and snack sizes for every table, trip and gathering.</p></div>
  </div>
 </div>
</section>

<section class="craft" id="tradicion">
 <div class="wrap">
  <div class="head"><h2 data-i18n="craftTitle">Colombian tradition, handled with care</h2><p data-i18n="craftSub">Every pack carries the care of a recipe passed from one generation to the next.</p></div>
  <div class="feat">
   <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 20c0-9 5-15 15-15 0 10-6 15-15 15zM5 20c3-5 6-8 10-10"/></svg><h3 data-i18n="c1t">Natural spirit</h3><p data-i18n="c1d">Inspired by the land and flavors of Colombia.</p></div>
   <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3l2.600 5.600 6 .7-4.500 4.100 1.200 6L12 16.500 6.700 19.400l1.200-6L3.400 9.300l6-.7z"/></svg><h3 data-i18n="c2t">Quality you can taste</h3><p data-i18n="c2d">Careful production and sealed packaging to arrive fresh.</p></div>
   <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 11h16v2a8 8 0 0 1-16 0zM8 4c-1 2 1 3 0 5M12 4c-1 2 1 3 0 5M16 4c-1 2 1 3 0 5"/></svg><h3 data-i18n="c3t">Perfect with coffee</h3><p data-i18n="c3d">A Colombian classic for the afternoon tinto, café con leche or hot chocolate.</p></div>
  </div>
 </div>
</section>

<section id="testimonios">
 <div class="wrap">
  <div class="head"><h2 data-i18n="testTitle">Words from our community</h2></div>
  <div class="quotes">
   <blockquote><p data-i18n="q1">"I opened the box and my kitchen smelled like my childhood in Medellín."</p><cite>Carolina R., Miami, FL</cite></blockquote>
   <blockquote><p data-i18n="q2">"My kids finally understand what I mean when I say 'a taste of home'."</p><cite>Andrés M., Houston, TX</cite></blockquote>
   <blockquote><p data-i18n="q3">"The family pack was gone in one weekend with the cousins. Ordering again."</p><cite>Laura P., New Jersey</cite></blockquote>
  </div>
 </div>
</section>

<section class="promo" id="promociones">
 <div class="wrap">
  <div>
   <h2 data-i18n="promoTitle">Welcome offer: 10% off your first order</h2>
   <p data-i18n="promoText">Use this code at checkout and join our list for new flavors, holiday boxes and Colombian traditions.</p>
   <span class="code" id="codigo">BIENVENIDO10</span>
  </div>
  <div>
   <form class="news" id="newsForm">
    <label for="email" class="sr" style="position:absolute;left:-999px" data-i18n="emailLabel">Email</label>
    <input type="email" id="email" required placeholder="you@email.com" autocomplete="email">
    <button class="btn" type="submit" data-i18n="join">Join</button>
   </form>
   <p class="msg" id="newsMsg" role="status"></p>
  </div>
 </div>
</section>

<section id="faq">
 <div class="wrap faqbox">
  <div class="head"><h2 data-i18n="faqTitle">Frequently asked questions</h2></div>
  <details><summary data-i18n="f1q">Where do you ship?</summary><p data-i18n="f1a">We ship to addresses across the United States. Delivery times appear at checkout.</p></details>
  <details><summary data-i18n="f2q">Are Quimbayas really made in Colombia?</summary><p data-i18n="f2a">Yes. Every pack is a Colombian product, selected to preserve the flavor you remember.</p></details>
  <details><summary data-i18n="f3q">How long do the cookies stay fresh?</summary><p data-i18n="f3a">Check the best-by date printed on each pack. Once opened, store them in a sealed container.</p></details>
  <details><summary data-i18n="f4q">Can I send them as a gift?</summary><p data-i18n="f4a">Absolutely. Add the recipient's address at checkout and tell us in the order notes.</p></details>
  <details><summary data-i18n="f5q">What if my order arrives damaged?</summary><p data-i18n="f5a">Write to us within 7 days with a photo and we will make it right.</p></details>
 </div>
</section>
</main>

<footer id="contacto">
 <div class="wrap">
  <div class="fgrid">
   <div><a class="logo" href="#inicio" style="color:var(--cream)">Quimbayas</a><p style="margin-top:.6rem;opacity:.85" data-i18n="fAbout">A little taste of Colombia, wherever life takes you.</p>
    <div class="soc"><a href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram">IG</a><a href="https://www.facebook.com/" target="_blank" rel="noopener" aria-label="Facebook">FB</a><a href="https://www.tiktok.com/" target="_blank" rel="noopener" aria-label="TikTok">TT</a><a href="https://wa.me/" target="_blank" rel="noopener" aria-label="WhatsApp">WA</a></div></div>
   <div><h3 data-i18n="fContact">Contact</h3><ul><li><a href="mailto:hello@quimbayas.com">hello@quimbayas.com</a></li><li><a href="https://wa.me/" target="_blank" rel="noopener">WhatsApp</a></li><li data-i18n="fHours">Mon–Fri, 9am–5pm ET</li></ul></div>
   <div><h3 data-i18n="fExplore">Explore</h3><ul><li><a href="#productos" data-i18n="nav2">Products</a></li><li><a href="#historia" data-i18n="nav3">Our story</a></li><li><a href="#promociones" data-i18n="promoLink">Offers</a></li><li><a href="#faq">FAQ</a></li></ul></div>
   <div><h3 data-i18n="fPolicies">Purchase policies</h3>
    <details><summary data-i18n="p1">Shipping</summary><p data-i18n="p1d">Orders ship within 1–3 business days. Tracking is sent by email.</p></details>
    <details><summary data-i18n="p2">Returns</summary><p data-i18n="p2d">Unopened packs can be returned within 14 days. Damaged items are replaced.</p></details>
    <details><summary data-i18n="p3">Privacy</summary><p data-i18n="p3d">We only use your data to process orders and never sell it.</p></details>
   </div>
  </div>
  <p class="copy">© <span id="year"></span> Quimbayas. <span data-i18n="rights">All rights reserved.</span></p>
 </div>
</footer>

<div class="ov" id="ov"></div>
<aside class="drawer" id="drawer" aria-label="Cart" aria-hidden="true">
 <header><h2 id="tituloCarrito">Cart (0)</h2><button class="x" id="cerrarCarrito" aria-label="Close">×</button></header>
 <ul id="lista-carrito"></ul>
 <div class="resumen">
  <p><span data-i18n="ship">Shipping</span>: <strong data-i18n="calc">Calculated at checkout</strong></p>
  <p class="total"><span data-i18n="total">Total</span>: <span id="total">$0.00</span></p>
  <div class="acts">
   <button class="btn vaciar sm" onclick="vaciarCarrito()" data-i18n="clear">Empty cart</button>
   <button class="btn sm" onclick="finalizarCompra()" data-i18n="checkout">Checkout</button>
  </div>
 </div>
</aside>
<div class="toast" id="toast" role="status"></div>

<script>
/* ===== PRODUCTS: edit prices (USD) here ===== */
const productos = [
  {id:1, precio:7.99, imagen:"https://farmawebonline.com/wp-content/uploads/2024/01/D_747699-MCO43145572981_082020-F-1-711x711.jpg"},
  {id:2, precio:5.49, imagen:"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQKicXbmjbP8K0YVIqgQL3P82iQIm_jvhATmt605Pr46cu31CbDB_znXcJ0&s=10"},
